{
  "name": "dsh-running-sessions",
  "version": "0.2.0",
  "description": "A live status bar in the DeepSeek Harness conversation header naming every session that is working right now: chips to jump in, waiting-for-you markers, and a full list one click away.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sessions",
    "running",
    "home",
    "dashboard"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "pretest": "node --check index.js && node --check client.js",
    "test": "node test/client.dom.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "license": "MIT",
  "author": "879745uhjun",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/879745uhjun/dsh-running-sessions.git"
  },
  "homepage": "https://github.com/879745uhjun/dsh-running-sessions#readme",
  "bugs": {
    "url": "https://github.com/879745uhjun/dsh-running-sessions/issues"
  }
}
